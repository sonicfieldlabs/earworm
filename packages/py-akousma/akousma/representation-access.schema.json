{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://earworm.dev/schemas/representation-access.schema.json",
  "title": "Representation access v1: actual input and operation role",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "earworm/representation-access/v1"
    },
    "access_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "representation_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "role": {
      "type": "string",
      "enum": [
        "subject",
        "account",
        "context",
        "instruction",
        "score",
        "work"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "withheld",
        "unsupported"
      ]
    },
    "received_representation_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "byte",
            "unicode_codepoint",
            "sequence_index",
            "sample",
            "unknown"
          ]
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "minItems": 0
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "kind",
        "unit",
        "ranges",
        "omissions"
      ]
    },
    "binding_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "contract",
    "access_id",
    "operation_ref",
    "representation_ref",
    "role",
    "status",
    "coverage"
  ]
}
