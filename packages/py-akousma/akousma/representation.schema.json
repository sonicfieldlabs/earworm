{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://earworm.dev/schemas/representation.schema.json",
  "title": "Representation v1: material identity independent of use",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "earworm/representation/v1"
    },
    "representation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "form": {
      "type": "string",
      "enum": [
        "text",
        "audio",
        "notation",
        "midi",
        "data",
        "morse",
        "glyphs",
        "code",
        "other"
      ]
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "encoding": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "recorded",
            "authored",
            "generated",
            "imported",
            "transformed",
            "unknown"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "acoustic",
            "non_acoustic",
            "mixed",
            "unknown"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "domain",
        "source_refs"
      ]
    },
    "source_class": {
      "type": "string",
      "enum": [
        "recording",
        "authored_work",
        "conversation",
        "correspondence",
        "dataset",
        "notation",
        "code",
        "generated_work",
        "retained_execution",
        "unknown",
        "other"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "retained",
            "reference_only",
            "not_retained",
            "withheld",
            "unknown"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inline_text": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "retained"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "ref",
              "sha256",
              "byte_count"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "reference_only"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        }
      ]
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "preserved",
            "transformed",
            "not_applicable"
          ]
        },
        "losses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "layout",
        "losses"
      ]
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "declared",
            "unknown",
            "not_applicable"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "declared"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "id",
              "revision"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "time_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sequence",
              "authored",
              "source_event",
              "capture",
              "execution",
              "unknown"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "clock_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "extent": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "number"
              },
              "end": {
                "type": "number"
              }
            },
            "required": [
              "start",
              "end"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "kind"
        ]
      },
      "minItems": 1
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "declared",
            "unknown"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "declared"
              }
            }
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "contract",
    "representation_id",
    "subject_ref",
    "form",
    "media_type",
    "origin",
    "source_class",
    "artifact",
    "preservation",
    "convention",
    "time_basis",
    "terms"
  ]
}
