{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://earworm.dev/schemas/listening-access.schema.json",
  "title": "Listening access declarations",
  "description": "Opt-in earworm/listening-access/v1. Four independent declarations; structural validity does not establish physical sensing or human perception. Known means explicitly declared with evidence references, not independently verified.",
  "type": "object",
  "required": [
    "contract",
    "declaration_id",
    "subject_ref",
    "capture",
    "sampled_representation",
    "model_input",
    "human_access"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "earworm/listening-access/v1"
    },
    "declaration_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "capture": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "status",
            "apparatus_ref",
            "supported_band_hz",
            "evidence_refs"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "known"
            },
            "apparatus_ref": {
              "type": "string",
              "minLength": 1
            },
            "supported_band_hz": {
              "type": "object",
              "required": [
                "lower",
                "upper"
              ],
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "type": "number",
                  "minimum": 0
                },
                "upper": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "withheld",
                "unavailable",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "sampled_representation": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "status",
            "representation_ref",
            "sample_rate_hz",
            "retained_band_hz",
            "evidence_refs",
            "channels"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "known"
            },
            "representation_ref": {
              "type": "string",
              "minLength": 1
            },
            "sample_rate_hz": {
              "type": "number",
              "minimum": 1
            },
            "retained_band_hz": {
              "type": "object",
              "required": [
                "lower",
                "upper"
              ],
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "type": "number",
                  "minimum": 0
                },
                "upper": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "withheld",
                "unavailable",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "model_input": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "status",
            "model_ref",
            "representation_ref",
            "sample_rate_hz",
            "effective_band_hz",
            "window_s",
            "preprocessing_refs",
            "evidence_refs",
            "channels",
            "blind_spots"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "known"
            },
            "model_ref": {
              "type": "string",
              "minLength": 1
            },
            "representation_ref": {
              "type": "string",
              "minLength": 1
            },
            "sample_rate_hz": {
              "type": "number",
              "minimum": 1
            },
            "effective_band_hz": {
              "type": "object",
              "required": [
                "lower",
                "upper"
              ],
              "additionalProperties": false,
              "properties": {
                "lower": {
                  "type": "number",
                  "minimum": 0
                },
                "upper": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "window_s": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "end": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "preprocessing_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            },
            "blind_spots": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "withheld",
                "unavailable",
                "not_applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "human_access": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "status",
              "listener_ref",
              "chain_refs",
              "conditions",
              "rendering_refs",
              "access_modes",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "known"
              },
              "listener_ref": {
                "type": "string",
                "minLength": 1
              },
              "chain_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "conditions": {
                "type": "string",
                "minLength": 1
              },
              "rendering_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "access_modes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "acoustic",
                    "visual",
                    "tactile",
                    "textual",
                    "other"
                  ]
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "withheld",
                  "unavailable",
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
